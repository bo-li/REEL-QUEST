# REEL-QUEST dashboard secrets — template.
#
# Local:  copy to .streamlit/secrets.toml (gitignored) and fill in.
# Cloud:  paste the same contents into the Streamlit Community Cloud app's
#         Settings → Secrets box. Never commit the filled-in file.
#
# Everything here also works as an environment variable of the same name.

# Powers the no-signup "Free models" mode: visitors chat immediately without
# entering a key. The app restricts this key to zero-cost OpenRouter IDs (a
# ":free" suffix, or the "openrouter/free" router), so it cannot be spent on
# paid models. Get one at https://openrouter.ai/keys — omit it and the free
# mode is simply not offered.
OPENROUTER_FREE_API_KEY = "sk-or-v1-..."

# Optional prefills for the "Your own API key" mode.
# RELQUEST_API_KEY = ""
# RELQUEST_CLOUD_BASE_URL = "https://openrouter.ai/api/v1"
# RELQUEST_CLOUD_MODEL = "openai/gpt-4o-mini"

# Optional: force-show the local Ollama mode even when the server is not
# reachable at import time (useful when starting Ollama after the app).
# RELQUEST_ENABLE_OLLAMA = "1"
