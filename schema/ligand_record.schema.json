{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bo-li/REEL-QUEST/blob/main/schema/ligand_record.schema.json",
  "title": "REEL-QUEST ligand record",
  "description": "One line of data/sx_ligands_merged_v14_flat.jsonl, schema v0.3. Generated by scripts/generate_json_schema.py; see docs/DATABASE_STRUCTURE.md for prose and schema/data_dictionary.csv for units and provenance.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "v0.3",
      "description": "Record-shape version"
    },
    "ligand": {
      "type": "object",
      "description": "Identity, structure, names and classification of the extractant",
      "properties": {
        "Name": {
          "type": "string",
          "description": "Curated short name; unique across the database",
          "minLength": 1,
          "x-provenance": "curated"
        },
        "SMILES": {
          "type": "string",
          "description": "RDKit-canonical SMILES; the primary key (no duplicates)",
          "minLength": 1,
          "x-provenance": "curated"
        },
        "InChI": {
          "type": "string",
          "description": "Standard InChI",
          "x-provenance": "derived at ingest (RDKit)"
        },
        "InChI_Key": {
          "type": "string",
          "description": "Standard InChIKey",
          "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$",
          "x-provenance": "derived at ingest (RDKit)"
        },
        "IUPAC_Name": {
          "type": [
            "string",
            "null"
          ],
          "description": "IUPAC name",
          "x-provenance": "curated"
        },
        "CAS_Number": {
          "type": [
            "string",
            "null"
          ],
          "description": "CAS Registry Number",
          "pattern": "^\\d{2,7}-\\d{2}-\\d$",
          "x-provenance": "curated"
        },
        "PubChem_CID": {
          "type": [
            "integer",
            "null"
          ],
          "description": "PubChem compound ID",
          "minimum": 1,
          "x-provenance": "curated"
        },
        "Molecular_Formula": {
          "type": "string",
          "description": "Hill formula",
          "x-provenance": "derived at ingest (RDKit)"
        },
        "Molecular_Weight": {
          "type": [
            "number",
            "null"
          ],
          "description": "Average molecular weight",
          "exclusiveMinimum": 0,
          "x-units": "g mol-1",
          "x-provenance": "derived at ingest (RDKit)"
        },
        "Mechanism": {
          "type": "string",
          "description": "Extraction mechanism (vocab/mechanisms.json)",
          "enum": [
            "Cation_Exchange",
            "Solvation",
            "Anion_Exchange",
            "Ion_Pair",
            "Supramolecular",
            "Hybrid"
          ],
          "x-provenance": "curated"
        },
        "Subtype": {
          "type": "string",
          "description": "Chemical subtype, 21-value flat taxonomy (vocab/chemical_families.json)",
          "enum": [
            "Amide",
            "BLPhen",
            "Bipydiamide",
            "Butanediamide",
            "Crown_ether",
            "DAPhen",
            "DGA",
            "EDTA",
            "MAPhen",
            "Malonamide",
            "Multident_N_donor",
            "Nitrilotriacetamide",
            "Phosphate",
            "Phosphine_oxide",
            "Phosphonate",
            "Phosphoric_acid",
            "Phthalamic_acid",
            "Polyether_Diamide",
            "Polyphenol",
            "Pyridinediamide",
            "Tripodal-DGA"
          ],
          "x-provenance": "curated"
        },
        "Chemical_Family": {
          "type": "string",
          "description": "Same label as Subtype (kept for compatibility)",
          "enum": [
            "Amide",
            "BLPhen",
            "Bipydiamide",
            "Butanediamide",
            "Crown_ether",
            "DAPhen",
            "DGA",
            "EDTA",
            "MAPhen",
            "Malonamide",
            "Multident_N_donor",
            "Nitrilotriacetamide",
            "Phosphate",
            "Phosphine_oxide",
            "Phosphonate",
            "Phosphoric_acid",
            "Phthalamic_acid",
            "Polyether_Diamide",
            "Polyphenol",
            "Pyridinediamide",
            "Tripodal-DGA"
          ],
          "x-provenance": "curated"
        },
        "Extractant_Type": {
          "type": "string",
          "description": "Legacy SMARTS class; prefer Subtype",
          "x-provenance": "curated"
        },
        "Alternative_Names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Genuine synonyms only",
          "x-provenance": "curated"
        },
        "Community_Name": {
          "type": "string",
          "description": "Informal family nickname; uncurated, not for analysis",
          "x-provenance": "curated"
        }
      },
      "required": [
        "Name",
        "SMILES",
        "Mechanism",
        "Extractant_Type",
        "Subtype",
        "Chemical_Family",
        "Alternative_Names"
      ],
      "additionalProperties": false
    },
    "selectivity": {
      "type": "object",
      "description": "Selectivity trend across the lanthanide series, fitted from the record's own conditions",
      "properties": {
        "trend_classification": {
          "type": "string",
          "description": "Selectivity trend across La-Lu (see docs/DATABASE_STRUCTURE.md)",
          "enum": [
            "Ascending",
            "Reverse",
            "Flat",
            "Mixed",
            "Peaked",
            "U_Shaped",
            "Insufficient_Data"
          ],
          "x-provenance": "derived: trends.classify_selectivity_trend"
        },
        "trend_confidence": {
          "type": "string",
          "description": "Agreement of per-condition votes: High (unanimous), Medium (>70 %), Low; 'None' for Insufficient_Data",
          "enum": [
            "High",
            "Medium",
            "Low",
            "None"
          ],
          "x-provenance": "derived: trends.classify_selectivity_trend"
        },
        "element_coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "La",
              "Ce",
              "Pr",
              "Nd",
              "Pm",
              "Sm",
              "Eu",
              "Gd",
              "Tb",
              "Dy",
              "Ho",
              "Er",
              "Tm",
              "Yb",
              "Lu"
            ]
          },
          "uniqueItems": true,
          "description": "La-Lu elements the trend fit used (never Y/Sc)",
          "x-provenance": "derived: trends.classify_selectivity_trend"
        },
        "slope": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean of per-condition slopes of log D vs atomic number",
          "x-units": "dex per unit Z",
          "x-provenance": "derived: trends.classify_selectivity_trend"
        },
        "r_squared": {
          "type": [
            "number",
            "null"
          ],
          "description": "Mean per-condition R^2 of that fit",
          "minimum": 0,
          "maximum": 1,
          "x-units": "dimensionless",
          "x-provenance": "derived: trends.classify_selectivity_trend"
        },
        "notes": {
          "type": "string",
          "description": "Plain-language basis of the classification",
          "x-provenance": "derived: trends.classify_selectivity_trend"
        },
        "peak_element": {
          "type": "string",
          "enum": [
            "La",
            "Ce",
            "Pr",
            "Nd",
            "Pm",
            "Sm",
            "Eu",
            "Gd",
            "Tb",
            "Dy",
            "Ho",
            "Er",
            "Tm",
            "Yb",
            "Lu"
          ],
          "description": "Position of the extremum for Peaked / U_Shaped",
          "x-provenance": "derived: trends.classify_selectivity_trend"
        },
        "slope_CI_lower": {
          "type": [
            "number",
            "null"
          ],
          "description": "Lower bound of the 95 % two-stage bootstrap interval of `slope`",
          "x-units": "dex per unit Z",
          "x-provenance": "derived: uncertainty.bootstrap_trend_ci (seeded)"
        },
        "slope_CI_upper": {
          "type": [
            "number",
            "null"
          ],
          "description": "Upper bound of that interval",
          "x-units": "dex per unit Z",
          "x-provenance": "derived: uncertainty.bootstrap_trend_ci (seeded)"
        },
        "slope_std": {
          "type": [
            "number",
            "null"
          ],
          "description": "Bootstrap standard deviation of `slope`",
          "minimum": 0,
          "x-units": "dex per unit Z",
          "x-provenance": "derived: uncertainty.bootstrap_trend_ci (seeded)"
        }
      },
      "required": [
        "trend_classification",
        "trend_confidence",
        "element_coverage",
        "slope",
        "r_squared",
        "notes",
        "slope_CI_lower",
        "slope_CI_upper",
        "slope_std"
      ],
      "additionalProperties": false
    },
    "experimental_data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition_id": {
            "type": "string",
            "description": "Unique, stable condition identifier",
            "x-provenance": "curated"
          },
          "Acid_Name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Aqueous acid (mostly HNO3; 'Hcl' is hydrochloric acid as spelled in the source)",
            "x-provenance": "source-transcribed"
          },
          "Acid_Concentration_M": {
            "type": [
              "number",
              "null"
            ],
            "description": "Initial aqueous acid concentration",
            "minimum": 0,
            "x-units": "mol L-1",
            "x-provenance": "source-transcribed"
          },
          "Temperature_C": {
            "type": "number",
            "description": "Temperature",
            "x-units": "degC",
            "x-provenance": "source-transcribed"
          },
          "Solvent_Name": {
            "type": "string",
            "description": "Organic diluent",
            "x-provenance": "source-transcribed"
          },
          "Solvent_Ratio": {
            "type": [
              "string",
              "null"
            ],
            "description": "Volume ratio for mixed diluents, e.g. '7:3'",
            "x-provenance": "source-transcribed"
          },
          "Extractant_Concentration_M": {
            "type": [
              "number",
              "null"
            ],
            "description": "Extractant concentration in the organic phase",
            "minimum": 0,
            "x-units": "mol L-1",
            "x-provenance": "source-transcribed"
          },
          "Phase_Modifier_Name": {
            "type": "string",
            "description": "Organic phase modifier (empty string if none)",
            "x-provenance": "source-transcribed"
          },
          "Phase_Modifier_Concentration_M": {
            "type": [
              "number",
              "null"
            ],
            "description": "Phase modifier concentration",
            "x-units": "mol L-1",
            "x-provenance": "source-transcribed"
          },
          "Contact_Time": {
            "type": "string",
            "description": "Contact/equilibration time with unit, e.g. '60 min'",
            "x-provenance": "source-transcribed"
          },
          "Additives": {
            "type": "string",
            "description": "Other aqueous components, free text",
            "x-provenance": "source-transcribed"
          },
          "Co_Extractants": {
            "type": [
              "array",
              "null"
            ],
            "description": "Other extractants in the organic phase (a mixed solvent). The D belongs to the mixture: the condition stays on the main ligand's record but is left out of everything pooled across conditions (uncertainty.is_mixture)",
            "items": {
              "type": "object",
              "properties": {
                "Name": {
                  "type": "string",
                  "description": "Co-extractant name",
                  "x-provenance": "source-transcribed"
                },
                "SMILES": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Co-extractant structure",
                  "x-provenance": "source-transcribed"
                },
                "Concentration_M": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Co-extractant concentration in the organic phase",
                  "minimum": 0,
                  "x-units": "mol L-1",
                  "x-provenance": "source-transcribed"
                }
              },
              "required": [
                "Name"
              ],
              "additionalProperties": false
            }
          },
          "distribution_ratios": {
            "type": "object",
            "description": "D-values keyed by element symbol",
            "propertyNames": {
              "type": "string",
              "enum": [
                "La",
                "Ce",
                "Pr",
                "Nd",
                "Pm",
                "Sm",
                "Eu",
                "Gd",
                "Tb",
                "Dy",
                "Ho",
                "Er",
                "Tm",
                "Yb",
                "Lu",
                "Y",
                "Sc"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Distribution ratio D = [M]org/[M]aq, 6 significant figures (null only where the source gave no usable value)",
                  "exclusiveMinimum": 0,
                  "x-units": "dimensionless",
                  "x-provenance": "source-transcribed"
                },
                "log_value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "log10(D) as reported or digitised; agrees with `value` within 0.01 dex (validators.check_d_value_consistency)",
                  "x-units": "log10",
                  "x-provenance": "source-transcribed"
                },
                "n_replicates": {
                  "type": "integer",
                  "description": "Number of source values behind this cell",
                  "minimum": 1,
                  "x-provenance": "source-transcribed"
                },
                "sigma_log_D": {
                  "type": "number",
                  "description": "Uncertainty of log D (1 sigma). When `sigma_source` is 'measured', computed for this value (e.g. from the figure's marker size and axis scale); otherwise a prior by source type (uncertainty.SIGMA_PRIORS: 0.0715 dex for figure-digitised, the median reading uncertainty of the calibrated figures; 3.5 % relative, 0.0152 dex, for tabulated)",
                  "minimum": 0,
                  "x-units": "dex",
                  "x-provenance": "derived: uncertainty.classify_measurement_quality + compute_sigma_log_d, unless sigma_source is 'measured' (source data)"
                },
                "sigma_source": {
                  "type": "string",
                  "description": "Where sigma_log_D comes from: 'prior' by source type, or 'measured' for this value; absent means 'prior'",
                  "enum": [
                    "prior",
                    "measured"
                  ],
                  "x-provenance": "source-transcribed"
                },
                "value_origin": {
                  "type": "string",
                  "description": "How the value was obtained: 'reported' (a table or the text), 'digitised' (read off a figure marker), 'interpolated' (read off a fitted line or between points, or at an inferred condition), 'derived' (computed from other quantities), 'censored' (only a bound is known; see `censor`). Absent means reported or digitised, per source_quality",
                  "enum": [
                    "reported",
                    "digitised",
                    "interpolated",
                    "derived",
                    "censored"
                  ],
                  "x-provenance": "source-transcribed"
                },
                "censor": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "For a censored value, the direction of the bound: '>' (D exceeds `value`) or '<' (D is below it); `value`/`log_value` hold the bound. Censored cells are left out of trend fits, statistics and separation factors",
                  "enum": [
                    ">",
                    "<",
                    null
                  ],
                  "x-provenance": "source-transcribed"
                },
                "source_quality": {
                  "type": "string",
                  "description": "Whether the value was read from a figure or a table",
                  "enum": [
                    "figure",
                    "table"
                  ],
                  "x-provenance": "derived: uncertainty.classify_measurement_quality"
                }
              },
              "required": [
                "value",
                "log_value",
                "n_replicates",
                "sigma_log_D",
                "source_quality"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value_origin": {
                        "const": "censored"
                      }
                    },
                    "required": [
                      "value_origin"
                    ]
                  },
                  "then": {
                    "properties": {
                      "censor": {
                        "enum": [
                          ">",
                          "<"
                        ]
                      }
                    },
                    "required": [
                      "censor"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "censor": {
                        "enum": [
                          ">",
                          "<"
                        ]
                      }
                    },
                    "required": [
                      "censor"
                    ]
                  },
                  "then": {
                    "properties": {
                      "value_origin": {
                        "const": "censored"
                      }
                    }
                  }
                }
              ]
            },
            "minProperties": 1
          },
          "statistics": {
            "type": "object",
            "description": "Cache of the condition's own distribution_ratios, measured values only (censored bounds are left out); empty when every value of the condition is a bound",
            "properties": {
              "mean_log_d": {
                "type": "number",
                "description": "Mean log D over the condition's elements",
                "x-units": "log10",
                "x-provenance": "derived: utils.condition_statistics"
              },
              "std_log_d": {
                "type": "number",
                "description": "Population standard deviation of log D",
                "x-units": "dex",
                "x-provenance": "derived: utils.condition_statistics"
              },
              "min_log_d": {
                "type": "number",
                "description": "Smallest log D",
                "x-units": "log10",
                "x-provenance": "derived: utils.condition_statistics"
              },
              "max_log_d": {
                "type": "number",
                "description": "Largest log D",
                "x-units": "log10",
                "x-provenance": "derived: utils.condition_statistics"
              },
              "n_elements": {
                "type": "integer",
                "description": "Number of elements with a log D",
                "minimum": 0,
                "x-provenance": "derived: utils.condition_statistics"
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "maxProperties": 0
              },
              {
                "required": [
                  "mean_log_d",
                  "std_log_d",
                  "min_log_d",
                  "max_log_d",
                  "n_elements"
                ]
              }
            ]
          },
          "reference": {
            "type": "object",
            "description": "Where the condition's numbers came from (schema v0.3, rel_quest.references.upgrade_reference)",
            "properties": {
              "DOI": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Bare, lower-case DOI of the paper that measured the values; never a compilation DOI",
                "pattern": "^10\\.\\d{4,9}/[^\\s,]+$",
                "x-provenance": "source-transcribed"
              },
              "URL": {
                "type": "string",
                "description": "Source link when the paper has no DOI",
                "format": "uri",
                "x-provenance": "source-transcribed"
              },
              "Locator": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Figure or table in that paper, e.g. 'Figure 3', 'Table S2'",
                "x-provenance": "curated (parsed by references.parse_locator)"
              }
            },
            "required": [
              "DOI",
              "Locator"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "DOI": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "required": [
                    "URL"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "condition_id",
          "distribution_ratios",
          "statistics",
          "reference"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Experimental conditions"
    },
    "performance_summary": {
      "type": "object",
      "description": "Cache of counts (rel_quest.derived.performance_summary)",
      "properties": {
        "conditions_tested": {
          "type": "integer",
          "description": "Number of conditions",
          "minimum": 0,
          "x-provenance": "derived: derived.performance_summary"
        },
        "total_measurements": {
          "type": "integer",
          "description": "Number of D-values",
          "minimum": 0,
          "x-provenance": "derived: derived.performance_summary"
        },
        "elements_tested": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "La",
              "Ce",
              "Pr",
              "Nd",
              "Pm",
              "Sm",
              "Eu",
              "Gd",
              "Tb",
              "Dy",
              "Ho",
              "Er",
              "Tm",
              "Yb",
              "Lu",
              "Y",
              "Sc"
            ]
          },
          "description": "Same list as elements_measured",
          "x-provenance": "derived: derived.performance_summary"
        }
      },
      "required": [
        "conditions_tested",
        "total_measurements",
        "elements_tested"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Curation state, dates and lineage",
      "properties": {
        "added_date": {
          "type": "string",
          "description": "Date the record was added",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-provenance": "curated"
        },
        "last_updated": {
          "type": "string",
          "description": "Date the record's content last changed",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-provenance": "curated"
        },
        "taxonomy_version": {
          "type": "string",
          "description": "Classification generation (independent of schema_version)",
          "x-provenance": "curated"
        }
      },
      "required": [
        "added_date",
        "last_updated",
        "taxonomy_version"
      ],
      "additionalProperties": false
    },
    "data_quality": {
      "type": "object",
      "description": "Outlier flags and an uncalibrated quality index",
      "properties": {
        "overall_quality_score": {
          "type": "integer",
          "description": "Uncalibrated ordinal index 0-100 (CI width 30, coverage 30, measurement quality 20, outliers 20)",
          "minimum": 0,
          "maximum": 100,
          "x-provenance": "derived: uncertainty.compute_quality_score"
        },
        "quality_grade": {
          "type": "string",
          "description": "Grade from the score",
          "enum": [
            "High",
            "Medium",
            "Low"
          ],
          "x-provenance": "derived: uncertainty.compute_quality_score"
        },
        "outlier_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition_id": {
                "type": "string",
                "description": "Condition holding the flagged value",
                "x-provenance": "derived: uncertainty.detect_outliers"
              },
              "element": {
                "type": "string",
                "enum": [
                  "La",
                  "Ce",
                  "Pr",
                  "Nd",
                  "Pm",
                  "Sm",
                  "Eu",
                  "Gd",
                  "Tb",
                  "Dy",
                  "Ho",
                  "Er",
                  "Tm",
                  "Yb",
                  "Lu",
                  "Y",
                  "Sc"
                ],
                "description": "Element of the flagged value",
                "x-provenance": "derived: uncertainty.detect_outliers"
              },
              "log_D_measured": {
                "type": "number",
                "description": "Stored log D",
                "x-units": "log10",
                "x-provenance": "derived: uncertainty.detect_outliers"
              },
              "log_D_predicted": {
                "type": "number",
                "description": "Value on the condition's own linear fit",
                "x-units": "log10",
