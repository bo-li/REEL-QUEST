      "rationale": "Carbamoyl-Methyl-Phosphine-Oxide (parent)."
    },
    "CyMe4-BTBP": {
      "community_name": "BTBP",
      "rationale": "Cyclohexyl-Methyl-4 Bis-Triazinyl-BiPyridine; widely used SANEX baseline."
    },
    "DBD1MHDGA": {
      "community_name": "DGA",
      "rationale": "Asymmetric diglycolamide (di-butyl, di-2-methylheptyl); DGA family."
