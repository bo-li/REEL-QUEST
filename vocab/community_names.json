{
  "_description": "Maps each ligand to a community-recognized 'Type' label (DAPhen, TODGA, BTBP, ...) used by the RE separation literature. Loaded by scripts/apply_community_names.py. Edit the 'community_name' fields to refine; rationale and example_iupac are informational only.",
  "_resolution_order": [
    "by_name (exact Name match — highest priority, used for per-ligand overrides)",
    "by_family (Family_Name match — applies to all variants v1/v2/...)",
    "by_extractant_type (fallback that turns the schema label into a display form)"
  ],

  "by_family": {
    "3a": {
      "community_name": "DAPhen",
      "rationale": "4,7-dichloro-1,10-phenanthroline-2,9-bis(carboxamide) family from Lemport et al. 2020 (RSC Adv, d0ra05182a). DAPhen = DiAmide-Phenanthroline."
    },
    "4": {
      "community_name": "DGA",
      "rationale": "Liu 2022 internal code; 12 diglycolamide variants with diverse alkyl substitutions (none are TODGA, the symmetric tetra-octyl). Use generic 'DGA' until per-variant community names are curated."
    },
    "18C6": {
      "community_name": "18-Crown-6",
      "rationale": "Standard crown-ether community name."
    },
    "BuPh-MPPhen": {
      "community_name": "MPPhen",
      "rationale": "Mono-phosphine-oxide phenanthroline. Note: v2 in DB is actually BPPhen (bis-phosphine-oxide); see by_name override."
    },
    "C2-POPPhen": {
      "community_name": "POPPhen",
      "rationale": "Phosphoryl-O-phosphate phenanthroline (diethyl phosphonate ester); POPPhen series."
    },
    "C4-POPPhen": {
      "community_name": "POPPhen",
      "rationale": "Phosphoryl-O-phosphate phenanthroline (dibutyl phosphonate ester); POPPhen series."
